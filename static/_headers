# Cloudflare Pages 响应头配置
# 文档：https://developers.cloudflare.com/pages/configuration/headers/
# 该文件会被 Hugo 复制到 public/_headers，只在 Cloudflare Pages 上生效，
# 对 GitHub Pages 镜像无影响。

# 带 ?v= 版本号的静态资源可长期缓存
/css/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

# 全站安全头（HTML 默认由 Pages 设为 must-revalidate，这里不覆盖）
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
